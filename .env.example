# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
ALLOWED_SERVER_ID=your_discord_server_id_here
BOT_PREFIX=!

# Leave empty or comment out to allow all channels in the server
# Example: ALLOWED_CHANNELS=123456789,987654321
ALLOWED_CHANNELS=

# LM Studio Configuration (Local LLM)
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
LM_STUDIO_TIMEOUT=30
MAX_TOKENS=500
TEMPERATURE=0.8

# Bot Personality Settings
BOT_NAME=Gooby
RESPONSE_CHANCE=0.3

# Database Settings
DATABASE_PATH=./data/gooby.db
